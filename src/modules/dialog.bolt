dialog_tag minecraft:pause_screen_additions {
  "values": [
    {
      "id": "smithed:data_packs",
      "required": false
    }
  ]
}

dialog smithed:data_packs {
  "type": "minecraft:dialog_list",
  "external_title": {
    "translate": "menu.smithed.data_packs",
    "fallback": "%s...",
    "with": [
      {
        "translate": "selectWorld.dataPacks"
      }
    ]
  },
  "title": {
    "translate": "menu.smithed.data_packs.title",
    "fallback": "%s",
    "with": [
      {
        "translate": "selectWorld.dataPacks"
      }
    ]
  },
  "dialogs": "#smithed:data_packs",
  "exit_action": {
    "label": {
      "translate": "gui.back"
    },
    "width": 200
  }
}

dialog_tag smithed:data_packs {
  "values": [
    {
      "id": (./about),
      "required": false
    }
  ]
}

dialog ./about {
  "type": "minecraft:multi_action",
  "title": "No More Forever Projectiles",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Configurable max distance for projectiles that just shoot straight forever.\n\n\nAffects Wither Skulls, Wind Charges, Fireballs, Small Fireballs, and Dragon Fireballs.\n\nCan be disabled for each projectile type.",
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": ("v" + ctx.project_version + "\nBy runcows"),
        "color": "gray"
      },
      "width": 300
    }
  ],
  "actions": [
    {
      "label": "Issues",
      "action": {
        "type": "open_url",
        "url": "https://github.com/runcows/noMoreForeverProjectiles/issues"
      }
    },
    {
      "label": "Config...",
      "action": {
        "type": "minecraft:run_command",
        "command": ("function " + ./show_config + " with storage rc_forever_projectiles:storage config")
      }
    }
  ],
  "exit_action": {
    "action": {
      "type": "show_dialog",
      "dialog": "smithed:data_packs"
    },
    "label": {
      "translate": "gui.back"
    },
    "width": 200
  }
}